# Local development database (compose.yaml defaults)
MMGO_DB_HOST=localhost
MMGO_DB_PORT=5432
MMGO_DB_USER=postgres
MMGO_DB_PASSWORD=postgres
MMGO_DB_NAME=mmgo_dev
MMGO_TEST_DB_NAME=mmgo_test

# Production Phoenix release
DATABASE_URL=
SECRET_KEY_BASE=
PHX_HOST=localhost
PHX_SERVER=true
PORT=4000
POOL_SIZE=10
ECTO_SSL=true
ECTO_IPV6=false
DNS_CLUSTER_QUERY=

# Telegram Mini App and bot
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEB_APP_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_MINI_APP_URL=https://mmgo.example.com/play

# AI provider. DeepSeek takes precedence when both keys are configured.
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
AI_SPELL_MODEL=
AI_ALCHEMY_MODEL=
AI_COMBAT_MODEL=
AI_NARRATION_MODEL=
# Explicit escape hatch for a fallback-only alpha deployment without live AI.
MMGO_ALLOW_MOCK_AI_IN_PROD=false

# Federation identity and authenticated migration imports
FEDERATION_PUBLIC_BASE_URL=
FEDERATION_IMPORT_TOKEN=
FEDERATION_FREEZE_GAME_DAYS=28
FEDERATION_LEVEL_RETENTION_BPS=800
FEDERATION_XP_RETENTION_BPS=700

# Realm services and operations
OPERATOR_HANDLES=
DUEL_TAX_RATE_BPS=500
BLACK_MARKET_DETECTION_ENABLED=true
BLACK_MARKET_DELIVERY_GAME_DAYS=7
BLACK_MARKET_BASE_CHANCE_BPS=300
BLACK_MARKET_PRICE_SCALE_BPS=2
BLACK_MARKET_MAX_CHANCE_BPS=5000
BLACK_MARKET_FINE_MULTIPLIER=3

# Development-only conveniences
MMGO_LOCAL_DEMO_ENABLED=true
TELEGRAM_ALLOW_INSECURE_WEBHOOK=false
