<Layouts.app flash={@flash} public={true}>
  <section
    id="public-home"
    class="relative isolate flex min-h-[calc(100svh-4.5rem)] items-center overflow-hidden px-4 py-10 sm:px-6 sm:py-16 lg:px-8"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -left-32 top-1/4 size-[30rem] rounded-full border border-amber-200/10 shadow-[0_0_9rem_rgba(217,169,54,0.09),inset_0_0_8rem_rgba(217,169,54,0.04)]"
    >
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-24 bottom-0 size-80 rotate-12 rounded-[5rem] border border-rose-300/10"
    >
    </div>

    <div class="relative mx-auto grid w-full max-w-7xl gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(24rem,0.9fr)] lg:items-center lg:gap-16">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-200/15 bg-amber-200/5 px-3 py-1.5 font-[family-name:var(--font-sans)] text-[0.65rem] font-bold uppercase tracking-[0.2em] text-amber-200/70">
          <span class="size-1.5 rounded-full bg-emerald-300 shadow-[0_0_0.75rem_rgba(110,231,183,0.75)]">
          </span>
          Public alpha
        </div>

        <h1 class="mt-7 max-w-3xl font-[family-name:var(--font-serif)] text-5xl font-bold leading-[0.94] tracking-[-0.045em] text-stone-50 sm:text-7xl xl:text-[5.5rem]">
          Ministry of
          <span class="block bg-gradient-to-r from-amber-100 via-amber-300 to-orange-300 bg-clip-text text-transparent">
            MaGic Online
          </span>
        </h1>

        <p class="mt-7 max-w-2xl font-[family-name:var(--font-sans)] text-base leading-7 text-stone-300/75 sm:text-lg sm:leading-8">
          Многопользовательская RPG в Telegram. Заклинания, исследование мира, экономика, организации, PvE и PvP работают на одном серверном состоянии.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            id="home-play-in-telegram"
            href="https://t.me/mmgo_bot?start=play"
            target="_blank"
            rel="noreferrer"
            class="group inline-flex min-h-13 items-center justify-center gap-3 rounded-2xl bg-amber-200 px-6 font-[family-name:var(--font-sans)] text-sm font-bold text-stone-950 shadow-[0_1.25rem_4rem_rgba(217,169,54,0.16)] transition duration-300 hover:-translate-y-0.5 hover:bg-amber-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
          >
            <.icon
              name="hero-paper-airplane"
              class="size-5 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            /> Начать в Telegram
          </a>
          <.link
            id="home-enter-gate"
            navigate={~p"/play"}
            class="inline-flex min-h-13 items-center justify-center gap-3 rounded-2xl border border-white/15 bg-white/5 px-6 font-[family-name:var(--font-sans)] text-sm font-bold text-stone-200 transition duration-300 hover:-translate-y-0.5 hover:border-amber-200/30 hover:bg-white/8 hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-200"
          >
            Посмотреть врата <.icon name="hero-arrow-right" class="size-4" />
          </.link>
        </div>

        <div class="mt-10 flex flex-wrap gap-x-7 gap-y-3 border-t border-white/10 pt-6 font-[family-name:var(--font-sans)] text-xs text-stone-500">
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-check" class="size-4 text-emerald-300/70" /> Один Telegram-аккаунт
          </span>
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-check" class="size-4 text-emerald-300/70" /> Никаких паролей
          </span>
          <span class="inline-flex items-center gap-2">
            <.icon name="hero-check" class="size-4 text-emerald-300/70" /> Общий живой мир
          </span>
        </div>
      </div>

      <aside
        id="home-world-preview"
        class="relative mx-auto w-full max-w-lg overflow-hidden rounded-[2.25rem] border border-amber-200/15 bg-[#15110d]/90 p-1 shadow-[0_2.5rem_8rem_rgba(0,0,0,0.5),0_0_5rem_rgba(217,169,54,0.05)] backdrop-blur-xl"
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-x-16 top-0 h-px bg-gradient-to-r from-transparent via-amber-200/70 to-transparent"
        >
        </div>
        <div class="rounded-[2rem] border border-white/[0.055] p-5 sm:p-7">
          <div class="flex items-center justify-between gap-4">
            <div>
              <p class="font-[family-name:var(--font-sans)] text-[0.62rem] font-bold uppercase tracking-[0.22em] text-stone-500">
                Alpha scope
              </p>
              <p class="mt-2 font-[family-name:var(--font-serif)] text-2xl font-bold text-stone-100">
                Уже в сборке
              </p>
            </div>
            <span class="rounded-full border border-emerald-300/15 bg-emerald-300/5 px-3 py-1 font-[family-name:var(--font-sans)] text-[0.62rem] font-bold uppercase tracking-[0.16em] text-emerald-200/70">
              Online
            </span>
          </div>

          <div class="relative mt-6 overflow-hidden rounded-[1.6rem] border border-white/8 bg-[#090807] p-5 sm:p-6">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,rgba(217,169,54,0.16),transparent_11rem),linear-gradient(155deg,transparent,rgba(124,43,34,0.08))]"
            >
            </div>
            <div class="relative">
              <div class="flex items-start gap-4">
                <div class="flex size-11 shrink-0 items-center justify-center rounded-2xl border border-amber-200/15 bg-amber-200/5 text-amber-300">
                  <.icon name="hero-sparkles" class="size-5" />
                </div>
                <div>
                  <p class="font-[family-name:var(--font-sans)] text-[0.62rem] font-bold uppercase tracking-[0.18em] text-amber-300/60">
                    Spell system
                  </p>
                  <p class="mt-2 font-[family-name:var(--font-serif)] text-lg font-bold leading-6 text-stone-100">
                    Генерация и книга заклинаний
                  </p>
                  <p class="mt-2 font-[family-name:var(--font-sans)] text-sm leading-6 text-stone-500">
                    AI-интерпретация с серверной валидацией результата.
                  </p>
                </div>
              </div>

              <div class="my-5 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent">
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div class="rounded-2xl border border-white/8 bg-white/[0.025] p-4">
                  <.icon name="hero-map" class="size-5 text-amber-300/80" />
                  <p class="mt-3 font-[family-name:var(--font-serif)] text-base font-bold text-stone-200">
                    Мир
                  </p>
                  <p class="mt-1 font-[family-name:var(--font-sans)] text-xs leading-5 text-stone-500">
                    Карта, путешествия и события
                  </p>
                </div>
                <div class="rounded-2xl border border-white/8 bg-white/[0.025] p-4">
                  <.icon name="hero-building-library" class="size-5 text-amber-300/80" />
                  <p class="mt-3 font-[family-name:var(--font-serif)] text-base font-bold text-stone-200">
                    Системы
                  </p>
                  <p class="mt-1 font-[family-name:var(--font-sans)] text-xs leading-5 text-stone-500">
                    Экономика, академия и организации
                  </p>
                </div>
              </div>
            </div>
          </div>

          <p class="mt-5 text-center font-[family-name:var(--font-sans)] text-[0.66rem] font-bold uppercase tracking-[0.18em] text-stone-600">
            0.1.0-alpha.2
          </p>
        </div>
      </aside>
    </div>
  </section>
</Layouts.app>
