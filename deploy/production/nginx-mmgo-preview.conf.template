# This listener is reachable only through `just prod-tunnel`; it is never
# published on a host interface. Canonical proxy headers keep Phoenix's HTTPS
# and WebSocket origin checks active during the local HTTP preview.
server {
    listen 127.0.0.1:4080;
    server_name localhost;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host __MMGO_SERVER_NAME__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host __MMGO_SERVER_NAME__;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Origin https://__MMGO_SERVER_NAME__;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_hide_header Strict-Transport-Security;
        proxy_read_timeout 65s;
    }
}
