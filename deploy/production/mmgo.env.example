# Copy this file to /opt/mmgo/mmgo.env on the server, keep it mode 0600,
# and replace every CHANGE_ME value. Never commit the completed file.

# PostgreSQL runs only on the private Compose network. `openssl rand -hex 32`
# produces a strong password that can be copied into DATABASE_URL unchanged.
# Otherwise URL-encode punctuation (for example, `@` becomes `%40`).
POSTGRES_USER=mmgo
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=mmgo
DATABASE_URL=ecto://mmgo:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@postgres/mmgo
ECTO_SSL=false
POOL_SIZE=10

# Phoenix is published by Docker only on 127.0.0.1:4000 and nginx terminates TLS.
# `openssl rand -hex 64` is suitable for SECRET_KEY_BASE.
PHX_HOST=mmgo.example.com
PORT=4000
SECRET_KEY_BASE=CHANGE_ME_PHOENIX_SECRET

# Telegram Mini App authentication and bot configuration.
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_MINI_APP_URL=https://mmgo.example.com/play

# Federation endpoints are required in production, even for a single node.
FEDERATION_PUBLIC_BASE_URL=https://mmgo.example.com
FEDERATION_IMPORT_TOKEN=CHANGE_ME_FEDERATION_IMPORT_TOKEN

# DeepSeek is the production spell compiler. Model overrides are optional.
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
AI_SPELL_MODEL=deepseek-chat
